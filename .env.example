# nivara-ai — configuration
#
# `docker compose up` needs none of this: compose sets these by service name
# on the compose network. This file documents the keys for a non-compose run.

# Where this service listens.
NIVARA_PORT=8000

# The Nivara API, reached over the compose network as `api` by default.
NIVARA_API_BASE_URL=http://localhost:3000

# Qdrant, reached over the compose network as `qdrant` by default.
NIVARA_QDRANT_URL=http://localhost:6333

# Empty against a local, unauthenticated Qdrant. A managed cluster (Qdrant
# Cloud) requires this; leave empty for docker compose or any other Qdrant
# with no auth in front of it.
NIVARA_QDRANT_API_KEY=

# qdrant-client's own default (5 seconds) is fine against the compose
# network's same-host Qdrant. Raise this when running scripts/index_corpus.py
# (or the other build-time indexers) against a managed cluster — a batched
# upsert carries a dense, sparse and late-interaction vector per chunk, and
# that can outrun 5 seconds on a slower uplink.
NIVARA_QDRANT_TIMEOUT=5

# The Assistant token this service writes with — replies, Notes, transitions.
# The seed mints it fresh each `docker compose up` and prints it once to the
# migrate log; readiness reports `unauthenticated` until it is set. See the
# README's "Assistant token" section.
NIVARA_ASSISTANT_TOKEN=

# The model transport a Turn's calls go through. `replay` (the default) reads
# committed Recordings and needs none of the rest; only the deployed service
# and a deliberate Record run set `live`.
NIVARA_MODEL_TRANSPORT=replay

# A live *deploy* runs the failover chain (`nivara_ai/model/chain.py`): set
# whichever provider keys you hold and a rung with no key is skipped, the
# chain built from the rest in order. Groq covers rungs 1–2, Gemini rung 3.
NIVARA_GROQ_API_KEY=
NIVARA_GEMINI_API_KEY=

# Extra Groq keys (comma-separated) for `scripts/record_eval.py` to rotate
# through as each hits its daily cap — a batch-recording convenience only, the
# deployed chain uses NIVARA_GROQ_API_KEY alone.
NIVARA_GROQ_API_KEYS=

# A targeted Record run instead points the single-provider transport at one
# provider, so a Recording is captured against a named rung
# (`scripts/record_turn.py`). Leave these empty for a deploy.
NIVARA_MODEL_BASE_URL=
NIVARA_MODEL_API_KEY=
NIVARA_MODEL_PROVIDER=groq
NIVARA_MODEL_NAME=

# The model router (ticket 24, `nivara_ai/model/router.py`). An easy-looking
# Turn starts one rung down the failover chain. Measured and kept
# (`eval/router_ablation.md`, ADR-0011); the deployed service sets this `true`,
# the harness leaves it `false` so replay keeps measuring strongest-first.
NIVARA_MODEL_ROUTER_ENABLED=false

# The Trace sink (ticket 22, `nivara_ai/observability/`). Off by default and in
# CI — the harness asserts on the Trace the endpoint returns, not a vendor's
# copy. The deployed service turns it on and sets the Langfuse project key pair;
# a Turn's Trace then ships best-effort to Langfuse Cloud's Hobby tier
# (50k units/month, 30-day retention — see `observability/vendor.py`).
NIVARA_TRACE_EXPORT_ENABLED=false
NIVARA_LANGFUSE_HOST=https://cloud.langfuse.com
NIVARA_LANGFUSE_PUBLIC_KEY=
NIVARA_LANGFUSE_SECRET_KEY=

# The Gate (ticket 16). On by default; the deployed service always runs it.
# Set `false` only to Record the raw agent loop. Self-consistency (the one
# expensive signal) runs only inside the Uncertain band — see
# `eval/gate_calibration.md` for what fraction of Turns that is.
NIVARA_GATE_ENABLED=true
NIVARA_SELF_CONSISTENCY_SAMPLES=5
NIVARA_SELF_CONSISTENCY_TEMPERATURE=0.7

# The Slack ingress (ticket 26, `nivara_ai/slack/`). Off by default and in
# every test and CI run. The deployed service sets it `true` — it already holds
# the Assistant token, so the ingress runs as an in-process background task
# that discovers and answers unanswered Slack-source Tickets (decision 50),
# rather than as a second deployable.
NIVARA_SLACK_INGRESS_ENABLED=false
NIVARA_SLACK_INGRESS_INTERVAL_SECONDS=120
NIVARA_SLACK_INGRESS_BATCH=10

# The scoreboard job (ticket 23) reads NIVARA_REPORTER_TOKEN — the Reporter
# token, `analytics:read` and nothing else. It is deliberately NOT a Settings
# field and has no line here: the deployed service must have no path to it, so
# it lives only in the CI secret `.github/workflows/scoreboard.yml` reads. To
# run `scripts/scoreboard.py` by hand, pass it on the command line for that one
# invocation.
